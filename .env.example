# Environment configuration for PS 26250 Air Power Decision Support System
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=sqlite:///./airpower.db

# JWT & Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT=5/minute
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
MFA_ISSUER=AirPower-Demo

# ML & Model Paths
ML_MODEL_PATH=./ml/models

# CORS Whitelist (comma-separated)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080
